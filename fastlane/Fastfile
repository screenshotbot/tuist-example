default_platform(:ios)

platform :ios do
  desc "Description of what the lane does"
  lane :custom_lane do
    # add actions here: https://docs.fastlane.tools/actions
  end
  before_all do
    setup_circle_ci
  end
end

# Tuist is installed via mise (see .mise.toml). Locally you probably have
# `tuist` on your PATH already; on CI it's reached through mise.
def run_tuist(command)
  runner = system("which mise > /dev/null 2>&1") ? "mise exec --" : ""
  sh "cd .. && #{runner} tuist #{command}"
end

desc "Resolve dependencies and generate SimpleProject.xcworkspace from Project.swift"
lane :generate do
  run_tuist "install"
  run_tuist "generate --no-open"
end

DEVICE = "iPhone SE (3rd generation)"
SCHEME = "AllTests"

# Every channel this build uploads is grouped under one Screenshotbot build
# status, rather than one status per channel.
BATCH = "sample-app"

# Every test target that produces screenshots, read out of the Tuist graph.
#
# A target qualifies if it is tagged `screenshotbot` in Project.swift, or if it
# reaches SnapshotTesting through its dependencies — the transitive case, since
# real apps wrap the library in their own helper module rather than depending on
# it directly.
def snapshot_test_targets
  require "json"
  require "tmpdir"

  Dir.mktmpdir do |dir|
    run_tuist "graph --format json --no-open --output-path #{dir}"
    graph = JSON.parse(File.read(File.join(dir, "graph.json")))

    # Tuist serialises dictionaries as flat [key, value, key, value, ...] arrays.
    node_id = ->(node) do
      target = node["target"]
      target && [target["path"], target["name"]]
    end

    edges = {}
    graph["dependencies"].each_slice(2) do |source, destinations|
      id = node_id.call(source)
      edges[id] = destinations.map { |d| node_id.call(d) }.compact if id
    end

    reaches = ->(start, name) do
      seen = {}
      queue = edges.fetch(start, []).dup
      until queue.empty?
        node = queue.shift
        next if seen[node]
        return true if node[1] == name

        seen[node] = true
        queue.concat(edges.fetch(node, []))
      end
      false
    end

    targets = []
    graph["projects"].each_slice(2) do |path, project|
      next if path.include?("/.build/")  # the Swift package checkouts

      project["targets"].each do |name, target|
        next unless %w[unit_tests ui_tests].include?(target["product"])

        tagged = (target.dig("metadata", "tags") || []).include?("screenshotbot")
        targets << name if tagged || reaches.call([path, name], "SnapshotTesting")
      end
    end
    targets.sort
  end
end

# Two passes, because selective testing and snapshot testing want opposite
# things.
#
# Skipping a snapshot target means its channel gets no screenshots for that
# commit, and a skipped run is indistinguishable from one that produced nothing
# — so snapshot targets always run. Everything else is selective, which is where
# the time is saved anyway.
#
# Note the flags are repeated per target: `--test-targets A --test-targets B`.
# A comma-separated list is parsed as a single target name and fails with
# "The following targets were not found: A,B".
lane :tests do
  snapshot_targets = snapshot_test_targets
  UI.message("Snapshot test targets: #{snapshot_targets.join(', ')}")

  run_tuist %(test #{SCHEME} --device "#{DEVICE}" ) +
    %(--result-bundle-path output/SelectiveTests.xcresult ) +
    snapshot_targets.map { |t| "--skip-test-targets #{t}" }.join(" ")

  if snapshot_targets.empty?
    UI.important("No snapshot test targets found — nothing to force a full run for.")
  else
    run_tuist %(test #{SCHEME} --device "#{DEVICE}" --no-selective-testing ) +
      %(--result-bundle-path output/SnapshotTests.xcresult ) +
      snapshot_targets.map { |t| "--test-targets #{t}" }.join(" ")
  end
end

lane :fetch_screenshotbot do
    sh "curl https://cdn.screenshotbot.io/recorder.sh | sh"
end

lane :screenshotbot_upload_all do
  # For each __Snapshots__ directory, load it to screenshotbot.
  #
  # Two directories get skipped:
  #
  #  - Anything under Tuist/, because Tuist checks the Swift package
  #    dependencies out into Tuist/.build and swift-snapshot-testing carries
  #    __Snapshots__ directories of its own.
  #
  #  - Anything empty. The snapshots aren't committed, so on a fresh clone a
  #    directory only fills up if its tests actually ran — and with selective
  #    testing they might not have. Uploading an empty directory would tell
  #    Screenshotbot that every screenshot in the channel was deleted, rather
  #    than that nothing changed.
  snapshot_dirs = Dir.glob("../**/__Snapshots__/")
                     .reject { |dir| dir.include?("/Tuist/") }
                     .reject { |dir| Dir.glob("#{dir}**/*.png").empty? }

  if snapshot_dirs.empty?
    UI.important("No snapshots were written — skipping the Screenshotbot upload.")
  end

  # `--batch` collapses the per-channel uploads into a single build status, so a
  # commit gets one Screenshotbot notification covering every snapshot target
  # instead of one per channel. The batch name is shared across the invocations
  # below; that's what ties them together.
  snapshot_dirs.each do |dir|
    channel_name = dir[3..-("/__Snapshots__/".length + 1)]
    sh "~/screenshotbot/recorder --channel #{channel_name} --batch #{BATCH} " \
       "--directory #{dir} --recursive"
  end
end

lane :screenshotbot_ci do
  # `tests` generates the project itself, but the external packages still have
  # to be resolved before anything can be generated.
  run_tuist "install"
  tests
  fetch_screenshotbot
  screenshotbot_upload_all
end
